# Copiar a .env para desarrollo. Solo variables VITE_* llegan al navegador:
# NUNCA poner secretos acá.

# URL base de la API usada por el navegador. Por defecto /api/v1
# (proxy de Vite en desarrollo, Nginx en producción).
VITE_API_URL=/api/v1

# Solo desarrollo: a dónde redirige Vite las llamadas a /api (sin prefijo VITE_: no llega al navegador).
API_PROXY_TARGET=http://localhost:3000

# Solo desarrollo: puerto del servidor de Vite.
WEB_DEV_PORT=5173
